# Neon Postgres — Dashboard → Connection string (URI)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Segredo para tokens de desbloqueio (gere um valor aleatório longo)
UNLOCK_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Senha inicial da Roda da Vida (usada no seed)
Q_RODA_PASSWORD=roda2026

# Senha do painel da psicóloga (/painel)
ADMIN_PASSWORD=painel2026

# API
API_PORT=8787
# 0.0.0.0 = acessível na rede local (celular na mesma Wi‑Fi)
API_HOST=0.0.0.0
# Origens do front (Vercel + local). Separe por vírgula.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://SEU-APP.vercel.app

# Front (Vite) — só em produção no Vercel. Local: deixe vazio (usa proxy /api).
# Sem barra no final. Ex.: https://workspace-psigeovana-service.onrender.com
# VITE_API_URL=https://SEU-SERVICO.onrender.com
